              "id": "cf411f0f-afc3-40f3-9949-5f2b866d8495",
              "name": "=message",
              "value": "={{ \"🥫 \" + $('Edit Fields1').item.json.product_name.trim() + \" — \" + $('Edit Fields1').item.json.overall_verdict.toUpperCase() + \"\\n\\nAzúcar: \" + ($('Edit Fields1').item.json.sugar_light === \"rojo\" ? \"🔴\" : $('Edit Fields1').item.json.sugar_light === \"ámbar\" ? \"🟡\" : \"🟢\") + \" \" + $('Edit Fields1').item.json.sugars_100g + \" g/100 g\\nSal: \" + ($('Edit Fields1').item.json.salt_light === \"rojo\" ? \"🔴\" : \"🟢\") + \" \" + $('Edit Fields1').item.json.salt_100g + \" g/100 g\\nGrasa: \" + ($('Edit Fields1').item.json.fat_light === \"rojo\" ? \"🔴\" : \"🟢\") + \" \" + $('Edit Fields1').item.json.fat_100g + \" g/100 g\\nNutri-Score: \" + $('Edit Fields1').item.json.nutriscore_grade + \" · Preocupación: \" + $('Edit Fields1').item.json.concernScore + \"/3\\n\\n\" + $json.text }}",
              "type": "string"
            }
          ]
        },
        "options": {}
