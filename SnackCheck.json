    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const concernScore =\n  ($json.sugars_100g > 22.5 ? 1 : 0) +\n  ($json.salt_100g > 1.5 ? 1 : 0) +\n  ($json.fat_100g > 17.5 ? 1 : 0);\n\nreturn {\n  json: {\n    ...$json,\n    concernScore\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        0
      ],
      "id": "d09a4e9f-45ee-4275-b5d4-cbe6729d558d",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f85fba98-7ed1-4e9c-8550-c4bf8f57bd44",
              "name": "=sugar_light",
              "value": "={{ $json.sugars_100g < 5 ? \"verde\" : $json.sugars_100g <= 22.5 ? \"ámbar\" : \"rojo\" }}",
              "type": "string"
            },
            {
              "id": "b3a0ef73-e502-48b0-be91-fe5dbddc5105",
              "name": "=salt_light",
              "value": "={{ $json.salt_100g > 1.5 ? \"rojo\" : \"verde\" }}",
              "type": "string"
            },
            {
              "id": "1c2a823a-83bb-4810-a39b-0bc0c3ffb89a",
              "name": "=fat_light",
              "value": "={{ $json.fat_100g > 17.5 ? \"rojo\" : \"verde\" }}",
              "type": "string"
            },
            {
              "id": "7e5d6db8-b803-426a-9b77-9a94e4e62be9",
              "name": "=count_verdict",
              "value": "={{ $json.concernScore >= 2 ? \"no saludable\" : $json.concernScore === 1 ? \"moderado\" : \"saludable\" }}",
              "type": "string"
            },
            {
              "id": "822d63f6-d222-4f7f-8292-d5a9ac653a26",
              "name": "=overall_verdict",
              "value": "={{ ($json.concernScore >= 2 || $json.nutriscore_grade === \"d\" || $json.nutriscore_grade === \"e\") ? \"no saludable\" : ($json.concernScore === 1 || $json.nutriscore_grade === \"c\") ? \"moderado\" : \"saludable\" }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
